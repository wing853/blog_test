{{> layout/header}}

<main class="container py-5">
    <!-- [Section Title] -->
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h2 class="display-6 fw-bold mb-3" style="font-family: 'Lora', serif;">The Journal</h2>
            <p class="text-muted">기록은 기억보다 오래 남습니다.</p>
            <hr class="mx-auto" style="width: 50px; border-top: 2px solid var(--point-green);">
        </div>
    </div>

    <!-- [Board List Table] -->
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="table-responsive">
                <table class="table table-hover align-middle shadow-sm" style="background-color: white; border-top: 2px solid var(--text-black);">
                    <thead class="table-light">
                    <tr class="text-center">
                        <th style="width: 80px;">번호</th>
                        <th>제목</th>
                        <th style="width: 150px;">작성자</th>
                        <th style="width: 120px;">날짜</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#pageDTO.boards}}
                        <tr>
                            <td class="text-center text-muted small">{{id}}</td>
                            <td class="px-4">
                                <a href="/board/{{id}}" class="text-decoration-none text-dark fw-medium d-block py-2">
                                    {{title}}
                                </a>
                            </td>
                            <td class="text-center small">{{nickname}}</td>
                            <td class="text-center text-muted small">2026.05.08</td>
                        </tr>
                    {{/pageDTO.boards}}

                    {{^pageDTO.boards}}
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                아직 등록된 글이 없습니다.
                            </td>
                        </tr>
                    {{/pageDTO.boards}}
                    </tbody>
                </table>
            </div>

            <!-- [Pagination Area] -->
            <div class="d-flex justify-content-center mt-5">
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-natural">
                        <!-- 이전 버튼 -->
                        <li class="page-item {{#pageDTO.first}}disabled{{/pageDTO.first}}">
                            <a class="page-link" href="?page={{pageDTO.prevPage}}" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>

                        <!-- 페이지 번호 루프 -->
                        {{#pageDTO.pageNumbers}}
                            <li class="page-item"><a class="page-link" href="?page={{.}}">{{.}}</a></li>
                        {{/pageDTO.pageNumbers}}

                        <!-- 다음 버튼 -->
                        <li class="page-item {{#pageDTO.last}}disabled{{/pageDTO.last}}">
                            <a class="page-link" href="?page={{pageDTO.nextPage}}" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>

            <!-- [Write Button] -->
            {{#sessionUser}}
                <div class="text-end mt-3">
                    <a href="/board/save-form" class="btn btn-natural btn-fill">글쓰기</a>
                </div>
            {{/sessionUser}}
        </div>
    </div>
</main>

<!-- 페이지네이션 커스텀 CSS (Header에 이미 넣었다면 생략 가능) -->
<style>
    .pagination-natural .page-link {
        background-color: transparent;
        border: 1px solid var(--border-color);
        color: var(--text-light);
        font-size: 0.9rem;
        padding: 0.6rem 1rem;
        margin: 0 2px;
        transition: 0.3s;
    }
    .pagination-natural .page-link:hover {
        background-color: #f1f0eb;
        color: var(--text-black);
        border-color: var(--text-black);
    }
    .pagination-natural .page-item.active .page-link {
        background-color: var(--point-green);
        border-color: var(--point-green);
        color: white !important;
    }
    .pagination-natural .page-item.disabled .page-link {
        color: #d1cfc9;
    }
    /* 테이블 링크 효과 */
    table tbody tr:hover {
        background-color: #fdfdfd;
    }
</style>

{{> layout/footer}}